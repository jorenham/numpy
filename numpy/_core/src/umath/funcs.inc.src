/* -*- c -*- */

/*
 * This file is for the definitions of the non-c99 functions used in ufuncs.
 * All the complex ufuncs are defined here along with a smattering of real and
 * object functions.
 */

#define NPY_NO_DEPRECATED_API NPY_API_VERSION

#include <float.h>
#include <limits.h>

#include "npy_import.h"
#include "npy_static_data.h"
#include "module_state.h"
#include "multiarraymodule.h"

/*
 *****************************************************************************
 **                        PYTHON OBJECT FUNCTIONS                          **
 *****************************************************************************
 */

static PyObject *
npy_ObjectSinc(PyObject *x)
{
    PyObject *method;
    int found = PyObject_GetOptionalAttrString(x, "sinc", &method);
    if (found < 0) {
        return NULL;
    }
    if (found && PyCallable_Check(method)) {
        PyObject *result = PyObject_CallNoArgs(method);
        Py_DECREF(method);
        return result;
    }

    Py_XDECREF(method);

    /* The original Python sinc called sin on pi*x for object arrays. */
    PyObject *pi = PyFloat_FromDouble(NPY_PI);
    if (pi == NULL) {
        return NULL;
    }
    PyObject *y = PyNumber_Multiply(pi, x);
    Py_DECREF(pi);
    if (y == NULL) {
        return NULL;
    }
    int nonzero = PyObject_IsTrue(y);
    if (nonzero <= 0) {
        Py_DECREF(y);
        return nonzero < 0 ? NULL : PyFloat_FromDouble(1.0);
    }
    found = PyObject_GetOptionalAttrString(y, "sin", &method);
    if (found <= 0 || !PyCallable_Check(method)) {
        if (found >= 0) {
            PyErr_Format(PyExc_TypeError, "object of type %.200s has no callable sin method",
                         Py_TYPE(y)->tp_name);
        }
        Py_XDECREF(method);
        Py_DECREF(y);
        return NULL;
    }
    PyObject *numerator = PyObject_CallNoArgs(method);
    Py_DECREF(method);
    PyObject *result = numerator == NULL ? NULL : PyNumber_TrueDivide(numerator, y);
    Py_XDECREF(numerator);
    Py_DECREF(y);
    return result;
}

static PyObject *
Py_square(PyObject *o)
{
    return PyNumber_Multiply(o, o);
}

static PyObject *
Py_get_one(PyObject *NPY_UNUSED(o))
{
    return PyLong_FromLong(1);
}

static PyObject *
Py_reciprocal(PyObject *o)
{
    PyObject *one = PyLong_FromLong(1);
    PyObject *result;

    if (!one) {
        return NULL;
    }
    result = PyNumber_TrueDivide(one, o);
    Py_DECREF(one);
    return result;
}

/*
 * Define numpy version of PyNumber_Power as binary function.
 */
static PyObject *
npy_ObjectPower(PyObject *x, PyObject *y)
{
    return PyNumber_Power(x, y, Py_None);
}

/**begin repeat
 * #Kind = Max, Min#
 * #OP = Py_GE, Py_LE#
 */
NPY_NO_EXPORT PyObject *
npy_Object@Kind@(PyObject *i1, PyObject *i2)
{
    PyObject *result;
    int cmp;

    cmp = PyObject_RichCompareBool(i1, i2, @OP@);
    if (cmp < 0) {
        return NULL;
    }
    if (cmp == 1) {
        result = i1;
    }
    else {
        result = i2;
    }
    return Py_NewRef(result);
}
/**end repeat**/

/* Emulates Python's 'a or b' behavior */
static PyObject *
npy_ObjectLogicalOr(PyObject *i1, PyObject *i2)
{
    if (i1 == NULL) {
        return Py_XNewRef(i2);
    }
    else if (i2 == NULL) {
        return Py_NewRef(i1);
    }
    else {
        int retcode = PyObject_IsTrue(i1);
        if (retcode == -1) {
            return NULL;
        }
        else if (retcode) {
            return Py_NewRef(i1);
        }
        else {
            return Py_NewRef(i2);
        }
    }
}

/* Emulates Python's 'a and b' behavior */
static PyObject *
npy_ObjectLogicalAnd(PyObject *i1, PyObject *i2)
{
    if (i1 == NULL) {
        return NULL;
    }
    else if (i2 == NULL) {
        return NULL;
    }
    else {
        int retcode = PyObject_IsTrue(i1);
        if (retcode == -1) {
            return NULL;
        }
        else if (!retcode) {
            return Py_NewRef(i1);
        }
        else {
            return Py_NewRef(i2);
        }
    }
}


/* Emulates Python's 'not b' behavior */
static PyObject *
npy_ObjectLogicalNot(PyObject *i1)
{
    if (i1 == NULL) {
        return NULL;
    }
    else {
        int retcode = PyObject_Not(i1);
        if (retcode == -1) {
            return NULL;
        }
        else if (retcode) {
            Py_RETURN_TRUE;
        }
        else {
            Py_RETURN_FALSE;
        }
    }
}

static PyObject *
npy_ObjectFloor(PyObject *obj) {
    return PyObject_Vectorcall(
            _npy_module_state->static_pydata.math_floor_func, &obj, 1, NULL);
}

static PyObject *
npy_ObjectCeil(PyObject *obj) {
    return PyObject_Vectorcall(
            _npy_module_state->static_pydata.math_ceil_func, &obj, 1, NULL);
}

static PyObject *
npy_ObjectTrunc(PyObject *obj) {
    return PyObject_Vectorcall(
            _npy_module_state->static_pydata.math_trunc_func, &obj, 1, NULL);
}

static PyObject *
npy_ObjectGCD(PyObject *i1, PyObject *i2)
{
    multiarray_umath_state *state = _npy_module_state;
    PyObject *gcd = NULL;
    PyObject *args[2] = {i1, i2};

    /* use math.gcd if valid on the provided types */
    {
        gcd = PyObject_Vectorcall(state->static_pydata.math_gcd_func,
                                  args, 2, NULL);
        if (gcd != NULL) {
            return gcd;
        }
        /* silence errors, and fall back on pure-python gcd */
        PyErr_Clear();
    }

    /* otherwise, use our internal one, written in python */
    {
        if (npy_cache_import_runtime(
                "numpy._core._internal", "_gcd",
                &state->runtime_imports.internal_gcd_func) == -1) {
            return NULL;
        }
        gcd = PyObject_Vectorcall(state->runtime_imports.internal_gcd_func,
                                  args, 2, NULL);
        if (gcd == NULL) {
            return NULL;
        }
        /* _gcd has some unusual behaviour regarding sign */
        Py_SETREF(gcd, PyNumber_Absolute(gcd));
        return gcd;
    }
}

static PyObject *
npy_ObjectLCM(PyObject *i1, PyObject *i2)
{
    /* lcm(a, b) = abs(a // gcd(a, b) * b) */

    PyObject *gcd = npy_ObjectGCD(i1, i2);
    PyObject *tmp;
    if(gcd == NULL) {
        return NULL;
    }
    /* Floor divide preserves integer types - we know the division will have
     * no remainder
     */
    tmp = PyNumber_FloorDivide(i1, gcd);
    Py_DECREF(gcd);
    if(tmp == NULL) {
        return NULL;
    }

    Py_SETREF(tmp, PyNumber_Multiply(tmp, i2));
    if(tmp == NULL) {
        return NULL;
    }

    /* even though we fix gcd to be positive, we need to do it again here */
    Py_SETREF(tmp,  PyNumber_Absolute(tmp));
    return tmp;
}


static PyObject *
npy_ObjectClip(PyObject *arr, PyObject *min, PyObject *max) {
    PyObject *o = npy_ObjectMax(arr, min);
    if (o == NULL) {
        return NULL;
    }
    Py_SETREF(o, npy_ObjectMin(o, max));
    return o;
}

/* The half and single precision scalar loops evaluate sinc in double. */
/**begin repeat
 * #ftype = npy_double, npy_longdouble#
 * #ctype = npy_cdouble, npy_clongdouble#
 * #c = , l#
 * #eps = DBL_EPSILON, LDBL_EPSILON#
 * #tiny = DBL_MIN, LDBL_MIN#
 * #max_exp = DBL_MAX_EXP, LDBL_MAX_EXP#
 */
/* Get the residual and quotient for the sinpi reduction. The period is
 * 1 (sine) or 1/2 (sine and cosine). remquo handles large arguments. */
static inline @ftype@
sinpi_remainder@c@(@ftype@ x, @ftype@ period, int *quotient)
{
    /* Leave room for twice x when reducing to half-integers. */
    if (npy_isfinite(x) && npy_fabs@c@(x) < INT_MAX / 4) {
        @ftype@ t = x / period;
        *quotient = (int)(t + npy_copysign@c@(0.5@c@, t));
        @ftype@ r = x - *quotient * period;
        return r == 0 ? npy_copysign@c@(0, x) : r;
    }
    return remquo@c@(x, period, quotient);
}

NPY_NO_EXPORT @ftype@
npy_sinc@c@(@ftype@ x)
{
    if (!npy_isfinite(x)) {
        return x - x;
    }
    if (npy_fabs@c@(x) <= @eps@) {
        return 1;
    }
    int n = 0;
    @ftype@ r = sinpi_remainder@c@(x, 1, &n);
    if (r == 0) {
        return 0;
    }
    @ftype@ sinpi = (1 - 2 * (n & 1)) * npy_sin@c@(NPY_PI@c@ * r);
    return sinpi / (NPY_PI@c@ * x);
}

static void
nc_sinc@c@(@ctype@ *z, @ctype@ *out)
{
    @ftype@ x = npy_creal@c@(*z), y = npy_cimag@c@(*z);
    if (y == 0 && npy_isfinite(x)) {
        *out = npy_cpack@c@(npy_sinc@c@(x), 0);
        return;
    }

    /* Near zero the real part rounds to one. Use the quadratic term for
     * the imaginary part to avoid cancellation in the complex division. */
    if (npy_fabs@c@(x) <= @eps@ && npy_fabs@c@(y) <= @eps@) {
        @ftype@ im = npy_copysign@c@(0, y);
        if (x != 0 && (npy_fabs@c@(x) >= @tiny@ || npy_fabs@c@(y) >= @tiny@)) {
            im = -(NPY_PI@c@ * NPY_PI@c@ / 3) * x * y;
        }
        *out = npy_cpack@c@(1, im);
        return;
    }

    /* Use the complementary cosine near half-integers to keep both
     * components of sin(pi*z) accurate. */
    int quadrant = 0;
    @ftype@ r = sinpi_remainder@c@(x, 0.5@c@, &quadrant);
    @ftype@ b, gain = 1;
    int exponent = 0;
    const @ftype@ limit = (@max_exp@ - 1) * NPY_LOGE2@c@;
    if (npy_fabs@c@(y) > limit / NPY_PI@c@ && npy_isfinite(y) && npy_isfinite(x)) {
        /* Here sinh(b/4) and cosh(b/4) equal their leading exponential to
         * working precision. Restore exp(3*abs(b)/4) after division,
         * carrying its exponent separately so either component can overflow
         * without losing the other one. */
        b = npy_copysign@c@(fmin@c@(npy_fabs@c@(y) * (NPY_PI@c@ / 4), limit), y);
        int h_exp, z_exp;
        @ftype@ h = npy_frexp@c@(npy_exp@c@(npy_fabs@c@(b)), &h_exp);
        @ftype@ scale = fmax@c@(npy_fabs@c@(x), npy_fabs@c@(y));
        @ftype@ m = npy_frexp@c@(scale, &z_exp);
        x /= scale;
        y /= scale;
        gain = h * h * h / m;
        exponent = 3 * h_exp - z_exp;
    }
    else {
        b = NPY_PI@c@ * y;
    }
    @ctype@ angle = npy_cpack@c@(NPY_PI@c@ * r, b);
    @ctype@ num = (quadrant & 1) ? npy_ccos@c@(angle) : npy_csin@c@(angle);
    @ftype@ pi = (quadrant & 2) ? -NPY_PI@c@ : NPY_PI@c@;

    /* Scale before forming the dot products, including for subnormal z.
     * Restore the sign of the dominant component in the final multiply. */
    @ftype@ scale = npy_fabs@c@(x) >= npy_fabs@c@(y) ? x : y;
    @ftype@ re = x / scale, im = y / scale;
    @ftype@ abs_scale = npy_fabs@c@(scale);
    @ftype@ ar = (npy_creal@c@(num) / pi) / abs_scale;
    @ftype@ ai = (npy_cimag@c@(num) / pi) / abs_scale;
    @ftype@ factor = npy_copysign@c@(1, scale) / (re * re + im * im);
    *out = npy_cpack@c@((ar * re + ai * im) * factor, (ai * re - ar * im) * factor);
    if (exponent != 0 || gain != 1) {
        npy_csetreal@c@(out, npy_ldexp@c@(npy_creal@c@(*out) * gain, exponent));
        npy_csetimag@c@(out, npy_ldexp@c@(npy_cimag@c@(*out) * gain, exponent));
    }
}
/**end repeat**/

/*
 *****************************************************************************
 **                           COMPLEX FUNCTIONS                             **
 *****************************************************************************
 */


/*
 * Don't pass structures between functions (only pointers) because how
 * structures are passed is compiler dependent and could cause segfaults if
 * umath_ufunc_object.inc is compiled with a different compiler than an
 * extension that makes use of the UFUNC API
 */

/**begin repeat
 *
 * #NAME = CFLOAT, CDOUBLE, CLONGDOUBLE#
 * #ctype = npy_cfloat, npy_cdouble, npy_clongdouble#
 * #ftype = npy_float, npy_double, npy_longdouble#
 * #c = f, ,l#
 */

static void
nc_neg@c@(@ctype@ *a, @ctype@ *r)
{
    npy_csetreal@c@(r, -npy_creal@c@(*a));
    npy_csetimag@c@(r, -npy_cimag@c@(*a));
    return;
}

static void
nc_pos@c@(@ctype@ *a, @ctype@ *r)
{
    npy_csetreal@c@(r, +npy_creal@c@(*a));
    npy_csetimag@c@(r, +npy_cimag@c@(*a));
    return;
}

static void
nc_sqrt@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_csqrt@c@(*x);
    return;
}

static void
nc_rint@c@(@ctype@ *x, @ctype@ *r)
{
    npy_csetreal@c@(r, npy_rint@c@(npy_creal@c@(*x)));
    npy_csetimag@c@(r, npy_rint@c@(npy_cimag@c@(*x)));
}

static void
nc_log@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_clog@c@(*x);
    return;
}

static void
nc_log1p@c@(@ctype@ *x, @ctype@ *r)
{
    @ftype@ l = npy_hypot@c@(npy_creal@c@(*x) + 1,npy_cimag@c@(*x));
    npy_csetimag@c@(r, npy_atan2@c@(npy_cimag@c@(*x), npy_creal@c@(*x) + 1));
    npy_csetreal@c@(r, npy_log@c@(l));
    return;
}

static void
nc_exp@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_cexp@c@(*x);
    return;
}

static void
nc_exp2@c@(@ctype@ *x, @ctype@ *r)
{
    @ctype@ a;
    npy_csetreal@c@(&a, npy_creal@c@(*x)*NPY_LOGE2@c@);
    npy_csetimag@c@(&a, npy_cimag@c@(*x)*NPY_LOGE2@c@);
    nc_exp@c@(&a, r);
    return;
}

static void
nc_expm1@c@(@ctype@ *x, @ctype@ *r)
{
    @ftype@ a = npy_sin@c@(npy_cimag@c@(*x) / 2);
    npy_csetreal@c@(r, npy_expm1@c@(npy_creal@c@(*x)) * npy_cos@c@(npy_cimag@c@(*x)) - 2 * a * a);
    npy_csetimag@c@(r,npy_exp@c@(npy_creal@c@(*x)) * npy_sin@c@(npy_cimag@c@(*x)));
    return;
}

static void
nc_pow@c@(@ctype@ *a, @ctype@ *b, @ctype@ *r)
{
   *r = npy_cpow@c@(*a, *b);
    return;
}

static void
nc_acos@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_cacos@c@(*x);
    return;
}

static void
nc_acosh@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_cacosh@c@(*x);
    return;
}

static void
nc_asin@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_casin@c@(*x);
    return;
}


static void
nc_asinh@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_casinh@c@(*x);
    return;
}

static void
nc_atan@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_catan@c@(*x);
    return;
}

static void
nc_atanh@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_catanh@c@(*x);
    return;
}

static void
nc_cos@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_ccos@c@(*x);
    return;
}

static void
nc_cosh@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_ccosh@c@(*x);
    return;
}

static void
nc_log10@c@(@ctype@ *x, @ctype@ *r)
{
    nc_log@c@(x, r);
    npy_csetreal@c@(r, npy_creal@c@(*r) * NPY_LOG10E@c@);
    npy_csetimag@c@(r, npy_cimag@c@(*r) * NPY_LOG10E@c@);
    return;
}

static void
nc_log2@c@(@ctype@ *x, @ctype@ *r)
{
    nc_log@c@(x, r);
    npy_csetreal@c@(r, npy_creal@c@(*r) * NPY_LOG2E@c@);
    npy_csetimag@c@(r, npy_cimag@c@(*r) * NPY_LOG2E@c@);
    return;
}

static void
nc_sin@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_csin@c@(*x);
    return;
}

static void
nc_sinh@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_csinh@c@(*x);
    return;
}

static void
nc_tan@c@(@ctype@ *x, @ctype@ *r)
{
   *r = npy_ctan@c@(*x);
   return;
}

static void
nc_tanh@c@(@ctype@ *x, @ctype@ *r)
{
    *r = npy_ctanh@c@(*x);
    return;
}

/**end repeat**/
